diff --git a/tests/diff_test.rs b/tests/diff_test.rs
index 7fb94063b63493809d48a8eb5a264f8feadf5c13..e1e2c1e5f4fa6a1b5c8756fe276b99a03d901e07 100644
--- a/tests/diff_test.rs
+++ b/tests/diff_test.rs
@@ -1364,3 +1364,182 @@ fn test_cli_filter_invalid_glob_exits_with_error() {
         stderr
     );
 }
+
+mod ghw_cross_format {
+    use super::{run_wavecat_cli, run_wavediff_cli};
+    use std::process::Output;
+
+    const DIR: &str = "tests/data/ghw-cross-format";
+    const MARKER: &str = "cross_format.marker";
+    const FLAG: &str = "cross_format.packet.flag";
+
+    fn fixture(stem: &str, format: &str) -> String {
+        format!("{DIR}/{stem}.{format}")
+    }
+
+    fn check_code(output: &Output, code: i32) {
+        assert_eq!(output.status.code(), Some(code), "{output:?}");
+    }
+
+    fn packet_path(name: &str) -> Option<&'static str> {
+        let parts: Vec<_> = name
+            .split(|ch: char| !ch.is_ascii_alphanumeric() && ch != '_')
+            .filter(|part| !part.is_empty())
+            .collect();
+        match parts.as_slice() {
+            ["cross_format", "packet"] => Some("packet"),
+            ["cross_format", "packet", "valid"] => Some("valid"),
+            ["cross_format", "packet", "flag"] => Some("flag"),
+            _ => None,
+        }
+    }
+
+    #[test]
+    fn packet_paths_accept_only_the_fixture_record() {
+        assert_eq!(packet_path("/cross_format/packet"), Some("packet"));
+        assert_eq!(packet_path("cross_format.packet(valid)"), Some("valid"));
+        assert_eq!(packet_path("cross_format.packet.flag"), Some("flag"));
+        assert_eq!(packet_path("cross_format.packet_bad"), None);
+        assert_eq!(packet_path("cross_format.packet.other"), None);
+        assert_eq!(packet_path("other.packet.flag"), None);
+    }
+
+    fn check_signal(name: &str, left: &str, right: &str, expected_tick: Option<u64>) {
+        // A filter matching neither input also returns success.
+        for path in [left, right] {
+            let names = run_wavecat_cli(&["--names", "--filter", name, path]);
+            check_code(&names, 0);
+            assert_eq!(String::from_utf8_lossy(&names.stdout).trim(), name);
+        }
+        let diff = run_wavediff_cli(&["--no-attrs", "--filter", name, left, right]);
+        check_code(&diff, i32::from(expected_tick.is_some()));
+        if let Some(tick) = expected_tick {
+            let text = String::from_utf8_lossy(&diff.stdout);
+            let first = text.lines().find_map(|line| {
+                let mut words = line.split_whitespace();
+                let time = words.next()?.parse::<u64>().ok()?;
+                (words.next()? == name).then_some(time)
+            });
+            assert_eq!(first, Some(tick), "{text}");
+        }
+    }
+
+    fn check_missing_record(rich: &str, projection: &str) {
+        for (left, right) in [(rich, projection), (projection, rich)] {
+            let diff = run_wavediff_cli(&["--no-attrs", left, right]);
+            check_code(&diff, 1);
+            let text = String::from_utf8_lossy(&diff.stderr);
+            let owner = format!("Only in {rich}:");
+            let mut valid = false;
+            let mut flag = false;
+            for name in text
+                .lines()
+                .skip_while(|line| line.trim() != owner)
+                .skip(1)
+                .take_while(|line| line.starts_with("    "))
+            {
+                match packet_path(name) {
+                    Some("packet") => (valid, flag) = (true, true),
+                    Some("valid") => valid = true,
+                    Some("flag") => flag = true,
+                    _ => panic!("Unexpected signal {name} in {rich}: {text}"),
+                }
+            }
+            assert!(valid && flag, "Incomplete record inventory: {text}");
+            assert!(!text.contains(&format!("Only in {projection}:")), "{text}");
+        }
+    }
+
+    #[test]
+    fn vcd_fst_controls() {
+        for (left, right) in [("vcd", "fst"), ("fst", "vcd")] {
+            let baseline = fixture("baseline", left);
+            check_signal(MARKER, &baseline, &fixture("baseline", right), None);
+            check_signal(
+                MARKER,
+                &baseline,
+                &fixture("delayed", right),
+                Some(10_000_000),
+            );
+            // Changing only an undumped record field leaves both projections equal.
+            let diff = run_wavediff_cli(&[&baseline, &fixture("record_change", right)]);
+            check_code(&diff, 0);
+        }
+    }
+
+    #[test]
+    fn native_fst_retains_the_record_lost_via_vcd() {
+        let native = fixture("baseline", "native.fst");
+        let changed = fixture("record_change", "native.fst");
+        let projected = fixture("baseline", "fst");
+        check_missing_record(&native, &projected);
+        check_signal(MARKER, &native, &projected, None);
+        check_signal(
+            MARKER,
+            &projected,
+            &fixture("delayed", "native.fst"),
+            Some(10_000_000),
+        );
+        for (left, right) in [(&native, &changed), (&changed, &native)] {
+            check_signal(FLAG, left, right, Some(10_000_000));
+        }
+    }
+
+    #[test]
+    #[ignore = "requires GHW reader support with field paths (issue #39)"]
+    fn ghw_and_native_fst_share_record_values() {
+        for (left, right) in [("ghw", "native.fst"), ("native.fst", "ghw")] {
+            let baseline = fixture("baseline", left);
+            let peer = fixture("baseline", right);
+            let changed = fixture("record_change", right);
+            // Matched records and a deliberate field-only change exercise the
+            // same flattened field names printed by wavecat for native FST.
+            let diff = run_wavediff_cli(&["--no-attrs", &baseline, &peer]);
+            check_code(&diff, 0);
+            check_signal(FLAG, &baseline, &peer, None);
+            check_signal(FLAG, &baseline, &changed, Some(10_000_000));
+            check_signal(MARKER, &baseline, &changed, None);
+        }
+    }
+
+    #[test]
+    #[ignore = "requires GHW reader support (issue #39)"]
+    fn ghw_projection_and_delay() {
+        let ghw = fixture("baseline", "ghw");
+        for fmt in ["vcd", "fst"] {
+            let projection = fixture("baseline", fmt);
+            let delayed = fixture("delayed", "ghw");
+            check_missing_record(&ghw, &projection);
+            check_signal(MARKER, &ghw, &projection, None);
+            check_signal(MARKER, &projection, &ghw, None);
+            check_signal(MARKER, &projection, &delayed, Some(10_000_000));
+            check_signal(MARKER, &delayed, &projection, Some(10_000_000));
+        }
+    }
+
+    #[test]
+    #[ignore = "requires GHW reader support (issue #39)"]
+    fn ghw_preserves_record_only_change() {
+        let baseline = fixture("baseline", "ghw");
+        let changed = fixture("record_change", "ghw");
+        check_signal(MARKER, &baseline, &changed, None);
+        let diff = run_wavediff_cli(&["--no-attrs", &baseline, &changed]);
+        check_code(&diff, 1);
+        assert!(!String::from_utf8_lossy(&diff.stderr).contains("Signal name mismatch:"));
+        let text = String::from_utf8_lossy(&diff.stdout);
+        // The reader may represent the record as an aggregate or separate fields.
+        let mut ticks = Vec::new();
+        for line in text.lines() {
+            let mut words = line.split_whitespace();
+            let time = words.next().unwrap().parse::<u64>().unwrap();
+            let name = words.next().unwrap();
+            let expected_signal = matches!(packet_path(name), Some("packet" | "flag"));
+            let value_diff = line.contains("!=")
+                || line.contains("missing time in file")
+                || line.contains("only in file");
+            assert!(expected_signal && value_diff, "{line}");
+            ticks.push(time);
+        }
+        assert_eq!(ticks.into_iter().min(), Some(10_000_000), "{text}");
+    }
+}
